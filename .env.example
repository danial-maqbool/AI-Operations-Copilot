# OpsPilot Environment Configuration Example
# Copy this file to .env and configure your variables.

# Server Settings
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///data/opspilot.db

# AI Orchestration
AI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Operational & Safety Limits
MAX_TOOL_CALLS=8
MAX_AI_RESULT_ROWS=100
MAX_QUERY_SECONDS=15
VECTOR_STORE_PATH=data/vector_store
PII_REDACTION_ENABLED=true
LOG_LEVEL=INFO

# External Data Source Credentials (Optional Example)
# POSTGRES_CONNECTION_STRING=postgresql://user:password@localhost:5432/company_ops
